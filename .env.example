# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kbot_new_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Server
BASE_WEBHOOK_URL=https://your-domain.com
WEBHOOK_SECRET=change-me-to-random-32-char-string
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# Kitobxon bot
KITOBXON_BOT_TOKEN=123456:your-bot-token
KITOBXON_ADMIN_IDS=[935795577]
KITOBXON_WEBHOOK_PATH=/kitobxon/webhook
KITOBXON_MODE=webhook

# Kitobmillatbot bot
KITOBMILLATBOT_BOT_TOKEN=<yangi_bot_token>
KITOBMILLATBOT_ADMIN_IDS=[935795577]
KITOBMILLATBOT_WEBHOOK_PATH=/kitobmillatbot/webhook
KITOBMILLATBOT_MODE=webhook

# Millatchiroqlaribot bot
MILLATCHIROQLARIBOT_BOT_TOKEN=<millatchiroqlaribot_token>
MILLATCHIROQLARIBOT_ADMIN_IDS=[935795577]
MILLATCHIROQLARIBOT_WEBHOOK_PATH=/millatchiroqlaribot/webhook
MILLATCHIROQLARIBOT_MODE=webhook

# Barakali_tanlov_bot bot
BARAKALI_TANLOV_BOT_BOT_TOKEN=<barakali_tanlov_bot_token>
BARAKALI_TANLOV_BOT_ADMIN_IDS=[935795577]
BARAKALI_TANLOV_BOT_WEBHOOK_PATH=/barakali_tanlov_bot/webhook
BARAKALI_TANLOV_BOT_MODE=polling

# Manfaadli_konkurs_bot bot
MANFAADLI_KONKURS_BOT_BOT_TOKEN=<manfaadli_konkurs_bot_token>
MANFAADLI_KONKURS_BOT_ADMIN_IDS=[935795577]
MANFAADLI_KONKURS_BOT_WEBHOOK_PATH=/manfaadli_konkurs_bot/webhook
MANFAADLI_KONKURS_BOT_MODE=polling

# Kitobxonmillattbot bot
KITOBXONMILLATTBOT_BOT_TOKEN=<kitobxonmillattbot_token>
KITOBXONMILLATTBOT_ADMIN_IDS=[935795577]
KITOBXONMILLATTBOT_WEBHOOK_PATH=/kitobxonmillattbot/webhook
KITOBXONMILLATTBOT_MODE=polling

# Logging
LOG_LEVEL=INFO
WEBAPP_JWT_SECRET=change-me-webapp-jwt-secret-32chars
